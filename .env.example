# Copy to .env: docker compose reads it. A hosted deploy sets the same CAIRN_* variables on the container.

# Store alias clients see in refs (acme:e812): [a-z][a-z0-9-]{1,31}.
CAIRN_STORE_ALIAS=acme
# One-time token for creating the instance admin. Unset, the server logs a random one at first start.
CAIRN_SETUP_TOKEN=change-me

# Hosted deploys (compose sets the URL itself):
# CAIRN_DB__URL=postgresql://cairn:secret@db.example.com:5432/cairn
# Direct connection for migrations when CAIRN_DB__URL goes through a transaction pooler:
# CAIRN_DB__MIGRATE_URL=postgresql://owner:secret@db.example.com:5432/cairn
# CAIRN_LOG_LEVEL=INFO
# CAIRN_JSON_LOGS=true
